# Environment Configuration
# Copy to .env and fill in secrets

# ===== Application =====
NODE_ENV=development
APP_NAME=TailorOS
APP_VERSION=0.1.0

# ===== Server =====
BACKEND_PORT=5000
BACKEND_HOST=0.0.0.0
FRONTEND_PORT=5173
API_BASE_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173

# ===== Database (MongoDB) =====
MONGODB_URI=mongodb://mongodb:27017/tailoros
MONGODB_PORT=27017
MONGODB_NAME=tailoros

# ===== Cache (Redis) =====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ===== Background Jobs (BullMQ) =====
QUEUE_NAME=tailoros-jobs
QUEUE_CONCURRENCY=5

# ===== Authentication =====
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# ===== Email (for later) =====
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# ===== Storage (for later) =====
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# ===== Logging =====
LOG_LEVEL=debug
LOG_FORMAT=json

# ===== Security =====
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100
