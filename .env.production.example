# Copy this file to .env.production on the VPS. Generate unique secrets; do not use these placeholders.
NODE_ENV=production
DOMAIN=tailoros.example.com
MONGO_ROOT_USER=tailoros
MONGO_ROOT_PASSWORD=CHANGE_ME_URL_SAFE_RANDOM_PASSWORD
MONGO_APP_USER=tailoros_app
MONGO_APP_PASSWORD=CHANGE_ME_A_DIFFERENT_URL_SAFE_RANDOM_PASSWORD
MONGODB_URI=mongodb://tailoros_app:CHANGE_ME_A_DIFFERENT_URL_SAFE_RANDOM_PASSWORD@mongodb:27017/tailoros?authSource=tailoros
REDIS_PASSWORD=CHANGE_ME_ANOTHER_URL_SAFE_RANDOM_PASSWORD

JWT_SECRET=CHANGE_ME_RANDOM_SECRET_AT_LEAST_48_CHARACTERS
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_RANDOM_SECRET_AT_LEAST_48_CHARS
BARCODE_SIGNING_SECRET=CHANGE_ME_THIRD_RANDOM_SECRET_AT_LEAST_48_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

CLIENT_URL=https://tailoros.example.com
CORS_ORIGIN=https://tailoros.example.com

# Optional. WhatsApp remains unavailable until all provider values and the approved template are set.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ORDER_UPDATE_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_GRAPH_API_VERSION=v22.0
